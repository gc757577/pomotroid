{
  "name": "pomotroid",
  "version": "0.1.0-rc.5",
  "description": "ClearPomo — a focus and break timer based on Pomotroid",
  "author": {
    "email": "flyweight@pm.me",
    "name": "Christopher Murphy",
    "url": "https://github.com/splode"
  },
  "homepage": "https://github.com/Splode/pomotroid",
  "license": "MIT",
  "repository": "github:splode/pomotroid",
  "type": "module",
  "scripts": {
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "tauri": "tauri",
    "desktop:build:preview": "tauri build --bundles nsis",
    "release:licenses": "python scripts/generate-release-notices.py"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.19.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
