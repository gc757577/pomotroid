{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearPomo",
  "version": "0.1.0-rc.5",
  "identifier": "io.github.gc75.pomotroidfork.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run release:licenses && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ClearPomo",
        "width": 360,
        "height": 478,
        "minWidth": 240,
        "minHeight": 240,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#2F384B",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self'"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2017–2026 Christopher Murphy (Splode). MIT License.",
    "shortDescription": "클리어포모 · Pomotroid 기반 집중 타이머",
    "longDescription": "클리어포모(ClearPomo)는 Pomotroid를 기반으로 한 집중·휴식 타이머입니다. 기존 Pomotroid 저작권과 MIT 라이선스를 유지합니다.",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "dmg": {
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "startMenuFolder": "ClearPomo",
        "installerHooks": "windows/nsis-hooks.nsh",
        "template": "windows/installer.nsi",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "publisher": "Pomotroid Fork",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "target/preview-resources/": "licenses/"
    },
    "useLocalToolsDir": true
  },
  "mainBinaryName": "pomotroid-fork-preview"
}
